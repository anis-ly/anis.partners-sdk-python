    {"publicCode":"invoice_reveal_limit_exceeded","httpStatus":409,"retryable":false,"type":"https://developers.anis.ly/errors/invoice-reveal-limit-exceeded","retryGuidance":"Use individual reveal for selected cards; invoice reveal is capped at 100.","publicDocumentation":true},
