    {"publicCode":"network_not_removable","httpStatus":409,"retryable":false,"type":"https://developers.anis.ly/errors/network-not-removable","retryGuidance":"Anis added this network, so only Anis can remove it, or it is the last network the application has. Contact Anis support to change it.","publicDocumentation":true},
    {"publicCode":"key_duplicate","httpStatus":409,"retryable":false,"type":"https://developers.anis.ly/errors/key-duplicate","retryGuidance":"This invitation already took a key, so a newly generated key pair is refused too. Read the enrolment status first; to enrol a different key, ask Anis staff to restart the enrolment.","publicDocumentation":true},
    {"publicCode":"approval_stale","httpStatus":409,"retryable":false,"type":"https://developers.anis.ly/errors/approval-stale","retryGuidance":"Reload the exact configuration and begin a new review.","publicDocumentation":false},
